FROM swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:9.0.0-910b-ubuntu22.04-py3.11

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG HTTP_PROXY
ARG HTTPS_PROXY

ENV http_proxy=$HTTP_PROXY
ENV https_proxy=$HTTPS_PROXY
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY
ENV GIT_SSL_NO_VERIFY=true

ARG MEGATRON_COMMIT=1dcf0dafa
ARG MegatronAdaptor_COMMIT=f707a3b6
ARG TransformerEngineNPU_COMMIT=47d60449
ARG MBRIDGE_COMMIT=89eb10887887bc74853f89a4de258c0702932a1c
ARG MEGATRON_BRIDGE_REF=dev_rl

ARG SGL_KERNEL_NPU_URL=https://github.com/sgl-project/sgl-kernel-npu/releases/download/2026.6.1/sgl-kernel-npu-2026.6.1-torch2.10.0-py311-cann9.0.0-910b-aarch64.zip

WORKDIR /workspace

# 基础系统依赖
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        gcc g++ cmake libnuma-dev wget git curl jq vim build-essential unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* && \
    pip install --upgrade pip packaging setuptools==80.10.2 && \
    pip cache purge

# 环境变量设置
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        export LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/aarch64-linux/devlib/linux/aarch64:$LD_LIBRARY_PATH; \
    elif [ "$ARCH" = "x86_64" ]; then \
        export LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/x86_64-linux/devlib/linux/x86_64:$LD_LIBRARY_PATH; \
    fi && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh

# 配置 Git 全局信息
RUN git config --global user.email "temp@example.com" && \
    git config --global user.name "temp"

# 拉取 Ascend 主仓 main 分支
RUN git clone \
    -b main \
    https://gitcode.com/Ascend/slime-ascend.git \
    /workspace/slime-ascend

# 1. 安装 SGLang
RUN git clone \
        -b v0.5.13 \
        https://github.com/sgl-project/sglang.git \
        /workspace/sglang && \
    cd /workspace/sglang && \
    mv python/pyproject.toml python/pyproject.toml.backup && \
    mv python/pyproject_npu.toml python/pyproject.toml && \
    pip install -e "python[all_npu]"

# 2. 安装基础包
RUN pip install \
        torch==2.10.0 \
        torch_npu==2.10.0 \
        torchvision==0.25.0 \
        pybind11==3.0.3 \
        transformers==5.3.0 && \
    cd /tmp && \
    wget \
        --no-check-certificate \
        "${SGL_KERNEL_NPU_URL}" \
        -O sgl-kernel-npu-a2.zip && \
    unzip sgl-kernel-npu-a2.zip && \
    pip install torch_memory_saver*.whl && \
    pip install sgl_kernel_npu*.whl && \
    pip install deep_ep*.whl && \
    cd "$(pip show deep-ep | grep -E '^Location:' | awk '{print $2}')" && \
    ln -s deep_ep/deep_ep_cpp*.so && \
    rm -rf /tmp/*

# 4 & 5. 在线克隆并安装依赖
RUN cd /workspace && \
    \
    # 安装 mbridge
    git clone https://github.com/ISEEKYAN/mbridge.git && \
    cd mbridge && \
    git checkout ${MBRIDGE_COMMIT} && \
    pip install -e . && \
    cd /workspace && \
    \
    # 安装 Megatron-Bridge
    git clone https://github.com/fzyzcjy/Megatron-Bridge.git && \
    cd Megatron-Bridge && \
    git checkout ${MEGATRON_BRIDGE_REF} && \
    cd /workspace && \
    pip install \
        "nvidia-modelopt[torch]>=0.37.0" \
        --no-build-isolation && \
    \
    # 安装 Megatron-LM
    git clone \
        https://github.com/NVIDIA/Megatron-LM.git \
        --recursive && \
    cd Megatron-LM && \
    git checkout ${MEGATRON_COMMIT} && \
    pip install -e . && \
    cd /workspace && \
    \
    # 安装 MegatronAdaptor
    git clone https://gitcode.com/Ascend/MegatronAdaptor.git && \
    cd MegatronAdaptor && \
    git checkout ${MegatronAdaptor_COMMIT} && \
    pip install -e . && \
    cd /workspace && \
    \
    # 安装 TransformerEngineNPU
    git clone https://gitcode.com/Ascend/TransformerEngineNPU.git && \
    cd TransformerEngineNPU && \
    git checkout ${TransformerEngineNPU_COMMIT} && \
    pip install -e . && \
    cd /workspace

# 6. 安装 slime-ascend
RUN cd /workspace/slime-ascend && \
    pip install -e .

RUN pip uninstall -y \
        triton \
        triton-ascend \
        opencv-python && \
    pip install \
        triton-ascend==3.2.1 \
        --extra-index-url https://triton-ascend.osinfra.cn/pypi/simple/ \
        --trusted-host triton-ascend.osinfra.cn \
        --no-cache-dir && \
    pip list && \
    ARCH=$(uname -m) && \
    echo "export LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/${ARCH}-linux/devlib/linux/${ARCH}:\$LD_LIBRARY_PATH" >> ~/.bashrc && \
    echo "source /usr/local/Ascend/ascend-toolkit/set_env.sh" >> ~/.bashrc && \
    echo "source /usr/local/Ascend/nnal/atb/set_env.sh" >> ~/.bashrc && \
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
    
# Apply NPU patches（v0.3.0）
RUN cd /workspace/sglang; \
    git am --whitespace=fix /workspace/slime-ascend/docker/npu_patch/v0.3.0/sglang/*; \
    cd /workspace/Megatron-LM; \
    git am --whitespace=fix /workspace/slime-ascend/docker/npu_patch/v0.3.0/megatron/*; \
    cd /workspace/MegatronAdaptor; \
    git am --whitespace=fix /workspace/slime-ascend/docker/npu_patch/v0.3.0/megatron_adaptor/*; \
    cd /workspace/TransformerEngineNPU; \
    git am --whitespace=fix /workspace/slime-ascend/docker/npu_patch/v0.3.0/transformer_engine_npu/*; \
    cd /workspace/Megatron-Bridge; \
    git am --whitespace=fix /workspace/slime-ascend/docker/npu_patch/v0.3.0/megatron-bridge/*; \
    cd /workspace/mbridge; \
    git am --whitespace=fix /workspace/slime-ascend/docker/npu_patch/v0.3.0/mbridge/*

RUN pip list && \
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY

CMD ["/bin/bash"]